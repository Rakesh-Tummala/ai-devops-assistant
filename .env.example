# GROQ_API_KEY: required for all AI features (chat, log analysis,
# CI/CD generation, Dockerfile generation). Get one at https://console.groq.com
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_MODEL: optional override of the Groq model used for AI features.
# Defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL="llama-3.3-70b-versatile"

# GITHUB_USERNAME / GITHUB_TOKEN: required for the deploy flow — the backend
# pushes the generated project to a GitHub repo owned by this account.
# The token needs at least "repo" scope.
GITHUB_USERNAME="MY_GITHUB_USERNAME"
GITHUB_TOKEN="MY_GITHUB_TOKEN"

# GITHUB_REPO_NAME: optional, the fixed repo the deploy flow pushes to.
# Defaults to "ai-devops-deploy" if unset.
GITHUB_REPO_NAME="ai-devops-deploy"

# RENDER_API_KEY: required for the deploy flow — used to create/monitor the
# Render web service once the code is pushed to GitHub.
RENDER_API_KEY="MY_RENDER_API_KEY"

# ALLOWED_ORIGINS: comma-separated list of origins allowed to call this API
# (CORS). Example: "https://your-frontend.onrender.com,http://localhost:5173"
ALLOWED_ORIGINS="MY_ALLOWED_ORIGINS"

# APP_URL: the URL where this backend itself is hosted (e.g. the Render
# service URL for this repo, not the deploy target).
APP_URL="MY_APP_URL"
